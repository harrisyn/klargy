# ---------------------------------------------------------------------------
# Repo-root .env, read by `docker compose` (docker-compose.yml and
# docker-compose.prod.yml). Every value has a development default in
# docker-compose.yml; set the ones you need to change. For `npm run dev`
# without Docker, use frontend/.env (see frontend/.env.example) instead.
# ---------------------------------------------------------------------------

### Database. Default: the host's Postgres via host.docker.internal.
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/qms_db

### Secrets - generate each with: openssl rand -hex 32. Required in production.
# Signs login tokens.
JWT_SECRET=
# Encrypts payment keys, integration credentials and webhook secrets at rest.
# Keep it the same across deploys: changing it makes stored secrets unreadable.
# Development default: dev-only-master-encryption-key-change-in-production.
MASTER_ENCRYPTION_KEY=
CRON_SECRET=

### Addresses
# Public root URL of the web app. Tenant workspaces (and the desk and status
# pages EMRs link to) live at <slug>.<host>. Required in production.
# Development default: http://localhost:8003.
APP_URL=http://localhost:8003
# The same host, without the scheme.
APP_DOMAIN=localhost:8003
# Note for an EMR running in its own containers: it can reach this API at
# http://host.docker.internal:8003 (the Connect API ignores the host), but
# links it opens in a browser (desk, status) use APP_URL's workspace host.

### Branding
APP_NAME=Klargy

### Email (Mailpit catches everything in development)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=

### AI-assisted analytics (optional)
# AI_PROVIDER=anthropic
# AI_MODEL=
# AI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
