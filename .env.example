# ---------------------------------------------------------------------------
# The ONE environment template for the whole project.
#
#   Docker (dev or prod):  cp .env.example .env          (repo root)
#   No Docker (npm run dev): cp .env.example frontend/.env
#
# Both .env files are git-ignored. Anything left blank or commented out falls
# back to a development default (docker-compose.yml) or is simply disabled.
# In production (docker-compose.prod.yml, Vercel) the values marked REQUIRED
# must be set. Full walkthrough: docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

### Database (PostgreSQL) - REQUIRED
# Docker dev default: the host's Postgres via host.docker.internal.
# With `docker compose --profile localdb up`: postgresql://postgres:postgres@db:5432/qms_db
# No Docker: postgresql://postgres:postgres@localhost:5432/qms_db
# Neon/Supabase: use the pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/qms_db

### Secrets - REQUIRED in production. Generate each with: openssl rand -hex 32
# Signs login tokens. Production refuses to start with a short/default value.
JWT_SECRET=
# Encrypts payment keys, integration credentials and webhook secrets at rest.
# Keep it the same across deploys: changing it makes stored secrets unreadable.
# Empty in development uses a development-only default.
MASTER_ENCRYPTION_KEY=
# Bearer token a scheduler sends to /api/v1/cron/* (Vercel Cron does it itself).
CRON_SECRET=

### Domains and branding - REQUIRED in production
# Public root URL. Tenants live at <slug>.<host>, the superadmin at admin.<host>.
# Desk, status and email links are built on it. The app refuses to start in
# production without APP_URL.
#   docker compose (dev):  http://localhost:8003  /  localhost:8003
#   npm run dev:           http://localhost:3000  /  localhost:3000
#   production:            https://yourapp.com    /  yourapp.com
APP_URL=http://localhost:8003
# The same host, without the scheme.
APP_DOMAIN=localhost:8003
# Product name shown in the UI, page titles and emails.
APP_NAME=Klargy
# Shown on /privacy and /terms
LEGAL_CONTACT_EMAIL=
# Extra origins allowed to call the API cross-origin (comma separated).
# Not needed normally - the web app calls its own /api/v1.
ALLOWED_ORIGINS=

### First-run setup token (optional)
# A fresh install has no superadmin, so every page leads to /setup, where the
# first one is created. That page asks for a setup token:
#   - set SETUP_TOKEN here to choose it (openssl rand -hex 32), or
#   - leave it empty and the app generates one, stores it encrypted in the
#     database and prints it in the server log (docker compose logs app).
# The token stops mattering once the superadmin exists. See docs/DEPLOYMENT.md.
SETUP_TOKEN=

### Email (SMTP) - REQUIRED in production. Any relay works (Resend, Postmark, SES...).
# Docker dev defaults to the bundled Mailpit (mailpit:1025, UI on :9025).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

### Real-time (Pusher Channels protocol) - REQUIRED in production
# Docker dev wires up the bundled Soketi automatically; ignore this block.
# Production with docker-compose.prod.yml runs Soketi: pick any id/key/secret
# and set REALTIME_PUBLIC_HOST to where browsers reach it (e.g. rt.yourapp.com).
# Pusher: set REALTIME_CLUSTER and leave REALTIME_HOST empty. Ably (Pusher
# adapter) or your own Soketi: set REALTIME_HOST. All empty = polling fallback.
REALTIME_APP_ID=
REALTIME_KEY=
REALTIME_SECRET=
REALTIME_CLUSTER=mt1
REALTIME_HOST=
REALTIME_PORT=
REALTIME_TLS=true
# Where browsers reach the realtime server (may differ from REALTIME_HOST,
# e.g. internal soketi:6001 vs. rt.yourapp.com:443). Pusher: leave empty.
REALTIME_PUBLIC_HOST=
REALTIME_PUBLIC_PORT=
REALTIME_PUBLIC_TLS=true

### Custom tenant domains on Vercel (optional)
# With these set, a tenant's custom domain is attached to the Vercel project
# automatically and gets a certificate.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Override the CNAME target tenants are told to use (default on Vercel:
# cname.vercel-dns.com, otherwise APP_URL's host).
# CUSTOM_DOMAIN_CNAME_TARGET=

### SMS via Twilio (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

### WhatsApp: nothing to set here. Each organisation connects its own sender
### under Settings -> WhatsApp (docs/guides/whatsapp.md). Webhook URLs are built
### on APP_URL, which must be reachable from the internet.

### AI-assisted analytics (optional)
# Normally configured by the superadmin under AI Providers; these are the
# fallback when no provider is active there.
# AI_PROVIDER=anthropic    # anthropic | openai | azure_openai | gemini | openai_compatible
# AI_MODEL=                # azure_openai: the deployment name
# AI_BASE_URL=             # openai_compatible / azure_openai endpoint; optional proxy for openai
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# GEMINI_API_KEY=
# AI_API_KEY=              # key for openai_compatible (fallback for any provider)
# AI_REASONING_EFFORT=     # OpenAI/Azure reasoning models: none|minimal|low|medium|high|xhigh
# OPENAI_API=chat          # use Chat Completions instead of the Responses API
# AI_REQUEST_TIMEOUT_MS=120000

### Development only - NEVER set in production
# ALLOW_PRIVATE_OUTBOUND_URLS=true   # let webhooks/data sources call localhost
#                                    # (also needed for a private-network WhatsApp Web server)
# REQUIRE_EMAIL_VERIFICATION=false   # skip the OTP step on org sign-up
# RATE_LIMIT_DISABLED=true
