# ---------------------------------------------------------------------------
# Queue management - web app + API (one Next.js deployment)
# Copy to .env (local) or set in your host's environment settings (Vercel).
# ---------------------------------------------------------------------------

### Database (PostgreSQL). On Neon/Supabase use the pooled URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qms_db

### Secrets - generate each with: openssl rand -hex 32
# Signs login tokens. Production refuses to start with a short/default value.
JWT_SECRET=
# Encrypts payment keys, integration credentials and webhook secrets at rest.
# Changing it makes existing encrypted values unreadable. Required in
# production; in development an empty value uses the same development-only
# default as docker-compose.yml.
MASTER_ENCRYPTION_KEY=
# Bearer token Vercel Cron (or any scheduler) sends to /api/v1/cron/*
CRON_SECRET=

### Domains / branding
# Public root URL. Tenants live at <slug>.<host>, superadmin at admin.<host>.
# Desk, status and email links are built on it. Required in production (the
# app refuses to start without it). Local `npm run dev`: use
# APP_URL=http://localhost:3000 and APP_DOMAIN=localhost:3000, or leave
# APP_URL empty and links follow the address you open the app on.
APP_URL=https://yourapp.com
APP_DOMAIN=yourapp.com
APP_NAME=Klargy
# Shown on /privacy and /terms
LEGAL_CONTACT_EMAIL=
# Extra origins allowed to call the API cross-origin (comma separated).
# Not needed normally - the web app calls its own /api/v1.
ALLOWED_ORIGINS=

### Custom domains on Vercel (optional). With these set, a tenant's custom
### domain is attached to the project automatically and gets a certificate.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Override the CNAME target tenants are told to use (default on Vercel:
# cname.vercel-dns.com, otherwise APP_URL's host).
CUSTOM_DOMAIN_CNAME_TARGET=

### Real-time (Pusher Channels protocol). Pusher: set *_CLUSTER and leave
### *_HOST empty. Ably (Pusher adapter) or self-hosted Soketi: set *_HOST.
### Leave all empty to fall back to polling.
REALTIME_APP_ID=
REALTIME_KEY=
REALTIME_SECRET=
REALTIME_CLUSTER=mt1
REALTIME_HOST=
REALTIME_PORT=
REALTIME_TLS=true
# Where browsers reach the realtime server (may differ from *_HOST above,
# e.g. an internal soketi:6001 vs. realtime.yourapp.com:443). Pusher: leave empty.
REALTIME_PUBLIC_HOST=
REALTIME_PUBLIC_PORT=
REALTIME_PUBLIC_TLS=true

### Email (SMTP). Any provider's SMTP relay works (Resend, Postmark, SES...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

### SMS (optional, Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

### WhatsApp: nothing to set here. Each organisation connects its own
### WhatsApp sender under Settings → WhatsApp (docs/guides/whatsapp.md); its
### credentials are encrypted with MASTER_ENCRYPTION_KEY, and the webhook URLs
### it shows are built on APP_URL, which must be reachable from the internet.
### Plans include it with the "WhatsApp messages" feature (whatsappNotifications).
### A self-hosted WhatsApp Web server on a private network also needs
### ALLOW_PRIVATE_OUTBOUND_URLS=true (below).

### AI-assisted analytics (optional, provider-agnostic). Normally configured
### by the superadmin under AI Providers; these env vars are the fallback when
### no provider is active there.
# anthropic | openai | azure_openai | gemini | openai_compatible   (default: anthropic)
AI_PROVIDER=anthropic
# Model override. Anthropic defaults to claude-opus-5 and OpenAI to gpt-5-mini;
# gemini and openai_compatible need a name. For azure_openai this is the
# deployment name.
AI_MODEL=
# openai_compatible: the URL /chat/completions is appended to (Mistral, xAI,
#   Groq, DeepSeek, OpenRouter, vLLM, Ollama...).
# azure_openai: the resource endpoint, e.g. https://my-resource.openai.azure.com
#   (uses Azure's v1 API). Append ?api-version=2024-10-21 to use the classic
#   per-deployment route instead.
# openai: optional proxy/gateway URL (default https://api.openai.com/v1).
AI_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
GEMINI_API_KEY=
# Key for openai_compatible (also used as a fallback for any provider)
AI_API_KEY=
# OpenAI uses the Responses API. Set to "chat" to use Chat Completions instead
# (e.g. behind a proxy that only supports /chat/completions).
# OPENAI_API=chat
# Reasoning effort for OpenAI/Azure reasoning models (o-series, GPT-5 family):
# none | minimal | low | medium | high | xhigh. Unset = the model's default.
# Not every model accepts every value.
# AI_REASONING_EFFORT=low
# Per-request timeout for OpenAI, Azure and OpenAI-compatible calls (ms, default 120000).
# AI_REQUEST_TIMEOUT_MS=120000

### Development only - never set in production
# ALLOW_PRIVATE_OUTBOUND_URLS=true   # let webhooks/data sources call localhost
# REQUIRE_EMAIL_VERIFICATION=false   # skip the OTP step on org sign-up
# RATE_LIMIT_DISABLED=true
