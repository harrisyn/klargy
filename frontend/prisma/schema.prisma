// Queue Management System - Database Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                   @id @default(uuid())
  name                  String
  slug                  String?                  @unique
  email                 String?
  phone                 String?
  // Customer identity settings - JSON with field requirements
  identityFieldsConfig  Json?                    // {mrNumber: {required: true, label: "MR Number"}, ...}
  // Display settings for queues
  defaultDisplayMode    String                   @default("TICKET_ONLY") // TICKET_ONLY, NAME_AND_TICKET, FULL_INFO
  // What kind of place this is, and what it calls the people in its queues
  // ("patient", "guest", "client"...). Null label = the industry default.
  industry              String?                  // HEALTHCARE, RESTAURANT, RETAIL, BANKING, GOVERNMENT, EDUCATION, SALON, OTHER
  customerLabel         String?
  customerLabelPlural   String?
  // When a plan without lobby adverts first added media (starts the trial)
  displayMediaTrialStartedAt DateTime?
  // Subscription
  subscriptionId        String?                  @unique
  // White-labeling (gated behind the plan's customBranding feature)
  logoUrl               String?
  logoFileId            String?                  // storage provider's file id, used to delete the old logo on replace
  primaryColor          String?                  // hex, e.g. "#14b8a6"
  hidePoweredBy         Boolean                  @default(false)
  // Superadmin-controlled lifecycle switch - PAUSED shows a banner in the
  // tenant admin app and blocks public customer-facing entry points
  // (join/status pages) without blocking staff login.
  status                OrganizationStatus       @default(ACTIVE)
  // Patient notification preferences:
  // {"turnApproachingAt": 3, "email": true, "sms": false}
  notificationSettings  Json?
  // Tenant opt-in for AI-assisted analytics (also needs the plan's "ai" feature)
  aiEnabled             Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  locations             Location[]
  users                 User[]
  dataSources           DataSource[]
  subscription          OrganizationSubscription? @relation(fields: [subscriptionId], references: [id])
  servicePoints         ServicePoint[]
  addOns                OrganizationAddOn[]
  creditLedgerEntries   CreditLedgerEntry[]
  customDomain          CustomDomain?
  impersonationLogs     ImpersonationLog[]
  auditLogs             AuditLog[]
  webhookEndpoints      WebhookEndpoint[]
  integrations          Integration[]
  externalReferences    ExternalReference[]
  aiInsights            AiInsight[]
  displayMedia          DisplayMedia[]
  displayPlaylists      DisplayPlaylist[]
}

enum OrganizationStatus {
  ACTIVE
  PAUSED
}

// Audit trail for superadmin "log in as this org's admin" support tool.
// impersonatedUserId/superAdminId are plain ids (not relations) so a later
// user deletion doesn't cascade-delete history of who accessed what.
model ImpersonationLog {
  id                 String       @id @default(uuid())
  organizationId     String
  superAdminId       String
  impersonatedUserId String
  startedAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// A single custom domain an org can point at their workspace instead of
// using the shared <slug>.<appdomain> subdomain (gated behind the plan's
// customDomain feature). Verified by CNAME: the org points `domain` at the
// app's root domain, and we confirm that CNAME resolves before treating the
// mapping as live. No certificate provisioning here - TLS termination for
// arbitrary customer domains is a reverse-proxy/hosting concern outside this
// app's scope.
model CustomDomain {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  domain             String             @unique
  status             CustomDomainStatus @default(PENDING)
  verificationToken  String
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
}

model Location {
  id                String         @id @default(uuid())
  organizationId    String
  name              String
  address           String?
  timezone          String         @default("UTC")
  externalReference String?        // External system reference ID
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services          Service[]
  publicCode        String?        @unique
  // Lobby screen: ticker + media rotation. See DisplayMedia.
  // {"ticker":{"enabled":true,"messages":["..."],"speed":"normal"},
  //  "media":{"enabled":true,"mode":"interstitial"|"split","everySeconds":90},
  //  "callFlash":true}
  displayConfig     Json?
  displayMedia      DisplayMedia[]
  displayPlaylists  DisplayPlaylist[]
}

enum ServicePointType {
  RECEPTION
  TRIAGE
  CONSULTATION
  CASHIER
  PHARMACY
  LAB
  IMAGING
  OTHER
}

model ServicePoint {
  id             String                @id @default(uuid())
  organizationId String
  name           String                // e.g., "Reception Desk", "Consultation Room"
  displayName    String?               // Friendly name for display boards
  type           ServicePointType      @default(OTHER)
  isActive       Boolean               @default(true)
  capacity       Int                   @default(1) // Number of physical instances/desks
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       ServicePointService[] // Services this point can handle

  @@index([organizationId, isActive])
}

// Physical instance of a service point (e.g., "Reception 1", "Reception 2")
// Each instance can be independently occupied by an operator
model ServicePointInstance {
  id                     String              @id @default(uuid())
  servicePointServiceId  String
  instanceNumber         Int                 // 1, 2, 3... for naming (Reception 1, Reception 2)
  displayName            String?             // Display name for the instance (e.g., "Reception 1")
  isActive               Boolean             @default(true)
  isOccupied             Boolean             @default(false)
  occupiedByUserId       String?
  occupiedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  servicePointService    ServicePointService @relation(fields: [servicePointServiceId], references: [id], onDelete: Cascade)
  occupiedBy             User?               @relation("OccupiedInstances", fields: [occupiedByUserId], references: [id], onDelete: SetNull)
  servingEntries         QueueEntry[]        @relation("InstanceServingEntries") // Entries being served at this instance

  @@unique([servicePointServiceId, instanceNumber])
  @@index([servicePointServiceId, isActive])
  @@index([occupiedByUserId])
}

// Many-to-many relation between ServicePoints and Services
// Also tracks when an operator activates a service point for a service
model ServicePointService {
  id                  String                 @id @default(uuid())
  servicePointId      String
  serviceId           String
  isActive            Boolean                @default(true)
  capacity            Int                    // Number of physical instances/desks for this service point+service
  // Activation tracking - when an operator "sits at" a desk for this service
  isOccupied          Boolean                @default(false)
  activatedByUserId   String?
  activatedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  servicePoint        ServicePoint           @relation(fields: [servicePointId], references: [id], onDelete: Cascade)
  service             Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  activatedBy         User?                  @relation("ActivatedServicePoints", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  instances           ServicePointInstance[]

  @@unique([servicePointId, serviceId])
  @@index([serviceId])
  @@index([activatedByUserId])
}

enum ServiceType {
  INDIVIDUAL
  GENERAL
}

model Service {
  id              String        @id @default(uuid())
  locationId      String
  name            String
  description     String?
  type            ServiceType   @default(GENERAL)
  slotDuration    Int           @default(15) // minutes
  concurrentLimit Int           @default(1)
  activeDays      String        @default("1,2,3,4,5") // Mon-Fri
  startTime       String        @default("09:00")
  endTime         String        @default("17:00")
  isActive        Boolean       @default(true)
  // Queue requirements for public ticket generation
  requiresName    Boolean       @default(true)
  requiresPhone   Boolean       @default(false)
  allowAnonymous  Boolean       @default(false)  // If true, can get ticket without any info
  // Display settings for this service's queue
  displayMode     String?       // TICKET_ONLY, NAME_AND_TICKET, FULL_INFO (null = use org default)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  queues          Queue[]
  practitioners   Practitioner[]
  appointments    Appointment[]
  flowsFrom       ServiceFlow[] @relation("FromService")
  flowsTo         ServiceFlow[] @relation("ToService")
  servicePoints   ServicePointService[] // Service points that can handle this service
}

model Practitioner {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([userId, serviceId])
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Queue {
  id           String        @id @default(uuid())
  serviceId    String
  date         DateTime
  status       QueueStatus   @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slots        Slot[]
  entries      QueueEntry[]
  
  @@unique([serviceId, date])
}

model Slot {
  id           String        @id @default(uuid())
  queueId      String
  startTime    DateTime
  endTime      DateTime
  capacity     Int           @default(1)
  bookedCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  queue        Queue         @relation(fields: [queueId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

enum EntryStatus {
  WAITING
  SERVING
  SERVED
  CANCELLED
  NO_SHOW
}

model QueueEntry {
  id                     String                @id @default(uuid())
  queueId                String
  userId                 String
  ticketNumber           String
  status                 EntryStatus           @default(WAITING)
  priority               Int                   @default(0)
  sortOrder              Int                   @default(0)    // For drag-and-drop reordering
  servicePointInstanceId String?               // Which specific instance is serving this entry
  sessionId              String?               // Session ID for public users to track their tickets
  journeyId              String?               // Link to customer journey for cross-queue tracking
  // Previous queue entry ID if transferred from another service
  previousEntryId        String?
  joinedAt               DateTime              @default(now())
  calledAt               DateTime?
  servedAt               DateTime?
  completedAt            DateTime?
  serviceDuration        Int?                  // Actual service duration in minutes (for historical data)
  // Wait time before being called (minutes)
  waitDuration           Int?
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  queue                  Queue                 @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePointInstance   ServicePointInstance? @relation("InstanceServingEntries", fields: [servicePointInstanceId], references: [id])
  
  @@index([queueId, status])
  @@index([userId])
  @@index([sessionId])
  @@index([journeyId])
  @@index([servicePointInstanceId])
  @@index([updatedAt])
}

model ServiceFlow {
  id            String   @id @default(uuid())
  fromServiceId String
  toServiceId   String
  priority      Int      @default(0)    // Order in the flow (lower = earlier in sequence)
  displayName   String?                 // Optional name for this flow step
  condition     String?                 // JSON condition for when to auto-transition
  autoTransfer  Boolean  @default(false)
  isRequired    Boolean  @default(false) // If true, patient must go through this step
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fromService   Service  @relation("FromService", fields: [fromServiceId], references: [id], onDelete: Cascade)
  toService     Service  @relation("ToService", fields: [toServiceId], references: [id], onDelete: Cascade)
  
  @@unique([fromServiceId, toServiceId])
  @@index([fromServiceId, priority])
}

model Appointment {
  id            String    @id @default(uuid())
  userId        String
  serviceId     String
  slotId        String
  createdBy     String
  status        String    @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, COMPLETED
  rescheduledAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slot          Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  creator       User      @relation("CreatedAppointments", fields: [createdBy], references: [id])
  
  @@index([userId])
  @@index([serviceId])
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  LOCATION_ADMIN
  SERVICE_STAFF
  RECEPTIONIST
  PATIENT
}

model User {
  id                    String          @id @default(uuid())
  organizationId        String?
  email                 String          @unique
  password              String
  firstName             String
  lastName              String
  phone                 String?
  role                  UserRole        @default(PATIENT)
  isActive              Boolean         @default(true)
  // Extended identity fields stored as JSON
  identityData          Json?           // {mrNumber: "12345", idNumber: "ABC123", ...}
  // Browser fingerprint for session tracking (for anonymous users)
  browserFingerprint    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  queueEntries          QueueEntry[]
  appointments          Appointment[]
  createdAppointments   Appointment[]   @relation("CreatedAppointments")
  practitioners         Practitioner[]
  notifications         Notification[]
  activatedServicePoints ServicePointService[] @relation("ActivatedServicePoints")
  occupiedInstances     ServicePointInstance[] @relation("OccupiedInstances")
  journeys              CustomerJourney[]
  
  @@index([browserFingerprint])
}

enum NotificationType {
  QUEUE_JOINED
  TURN_APPROACHING
  NOW_SERVING
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  message   String
  // Set for queue notifications so each (entry, type) is only sent once.
  queueEntryId String?
  sentAt    DateTime            @default(now())
  readAt    DateTime?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, readAt])
  @@index([queueEntryId, type])
}

model Invite {
  id            String    @id @default(uuid())
  code          String    @unique
  role          UserRole  @default(SERVICE_STAFF)
  organizationId String?
  createdBy     String?
  used          Boolean   @default(false)
  email         String?   // who it was sent to, if sent by email
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([organizationId])
}

// Data sources for external customer data integration
enum DataSourceType {
  API
  DATABASE
  WEBHOOK
}

model DataSource {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  type            DataSourceType
  // Connection details stored as JSON
  config          Json           // {url, headers, auth, queryParams, dbConnection, etc}
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldMappings   FieldMapping[]
  
  @@index([organizationId])
}

// Maps data source response fields to User identity fields
model FieldMapping {
  id            String     @id @default(uuid())
  dataSourceId  String
  // Source field path in response (e.g., "data.patient.mrNumber")
  sourcePath    String
  // Target field in User.identityData (e.g., "mrNumber")
  targetField   String
  // Optional transformation function name
  transform     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  
  @@index([dataSourceId])
}

// Tracks customer journey across multiple queues
model CustomerJourney {
  id              String    @id @default(uuid())
  userId          String
  // Total time spent across all queues in this journey (minutes)
  totalDuration   Int?
  // Journey start (first queue entry)
  startedAt       DateTime  @default(now())
  // Journey end (last queue completion)
  completedAt     DateTime?
  // Array of queue entry IDs in order
  queueEntryIds   String[]
  // Journey metadata
  metadata        Json?     // {referralSource, initialService, etc}
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([startedAt])
  @@index([completedAt])
}

// =====================================================
// SUBSCRIPTION MANAGEMENT
// =====================================================

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
}

// Defines subscription tiers with feature limits
model SubscriptionPlan {
  id                    String                   @id @default(uuid())
  name                  String                   // "Free", "Starter", "Professional", "Enterprise"
  code                  String                   @unique // "free", "starter", "pro", "enterprise"
  description           String?
  
  // Pricing
  priceMonthly          Decimal                  @default(0)
  priceYearly           Decimal                  @default(0)
  currency              String                   @default("USD")
  
  // Feature limits (null = unlimited)
  maxLocations          Int?                     // Max number of locations
  maxServicesPerLoc     Int?                     // Max services per location
  maxUsersPerOrg        Int?                     // Max staff users
  maxQueueEntriesPerDay Int?                     // Max daily queue entries across all queues
  maxQueueEntriesPerPeriod Int?                  // Max queue entries across the current billing period (null = unlimited)
  
  // Feature flags
  features              Json                     @default("{}") // {"analytics": true, "customBranding": false, "apiAccess": true, etc}
  
  // Display order
  displayOrder          Int                      @default(0)
  isActive              Boolean                  @default(true)
  isDefault             Boolean                  @default(false) // Default plan for new orgs
  priceQuarterly        Decimal                  @default(0)
  trialDurationDays     Int?                     // null = no time limit
  tierRank              Int                      @default(0) // separate from displayOrder; upgrade/recommended comparisons only
  isRecommended         Boolean                  @default(false) // one plan at a time
  expiredFallbackPlanId String?
  expiredFallbackPlan   SubscriptionPlan?        @relation("PlanFallback", fields: [expiredFallbackPlanId], references: [id], onDelete: SetNull)
  fallbackForPlans      SubscriptionPlan[]       @relation("PlanFallback")
  upgradePlanId         String?
  upgradePlan           SubscriptionPlan?        @relation("PlanUpgrade", fields: [upgradePlanId], references: [id], onDelete: SetNull)
  upgradeForPlans        SubscriptionPlan[]       @relation("PlanUpgrade")

  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  subscriptions         OrganizationSubscription[]
  creditAllowances      PlanCreditAllowance[]
  addOnPricingOverrides PlanAddOnPricingOverride[]

  @@index([code])
  @@index([isActive])
}

// Links organization to subscription plan with billing info
model OrganizationSubscription {
  id                    String             @id @default(uuid())
  planId                String
  
  // Billing info
  status                SubscriptionStatus @default(TRIAL)
  billingCycle          String             @default("monthly") // "monthly" or "yearly"
  
  // Trial period
  trialEndsAt           DateTime?
  
  // Current billing period
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  
  // Cancellation info
  cancelledAt           DateTime?
  cancelReason          String?
  
  // Which provider this subscription's recurring billing runs through
  provider              String?            // "stripe" | "paystack"
  // The provider's own recurring-subscription ID (renamed from externalPaymentId)
  externalProviderSubscriptionId String?
  
  // Usage tracking (updated periodically)
  usageStats            Json?              // {"locationsUsed": 2, "usersUsed": 5, "entriesThisMonth": 1234}
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id])
  organizations         Organization[]
  
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model PaymentProviderConfig {
  id            String   @id @default(uuid())
  provider      String   // "stripe" | "paystack"
  isActive      Boolean  @default(false)
  publicKey     String?
  secretKey     String   // encrypted at rest
  webhookSecret String   // encrypted at rest
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider])
}

model FileStorageProviderConfig {
  id            String   @id @default(uuid())
  provider      String   // "uploadcare"
  isActive      Boolean  @default(false)
  publicKey     String?
  secretKey     String   // encrypted at rest, same as PaymentProviderConfig
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider])
}

// Text message delivery for "you're nearly up" and reminders. One active at
// a time; env TWILIO_* is the fallback when none is configured here.
model SmsProviderConfig {
  id         String   @id @default(uuid())
  provider   String   @unique // "twilio" | "africastalking"
  isActive   Boolean  @default(false)
  accountId  String   // Twilio account SID, Africa's Talking username
  secret     String   // encrypted at rest: Twilio auth token, AT API key
  senderId   String?  // from number or approved sender name
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   // "stripe" | "paystack"
  eventId     String   // provider's own event ID
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

enum AddOnResourceType {
  LOCATIONS
  USERS
  DISPLAY_MEDIA // lobby media pack: large uploads, streams, more playlist items
}

enum AddOnBillingMode {
  RECURRING
  ONE_OFF
}

enum AddOnStatus {
  ACTIVE
  CANCELLED
}

model AddOnPricing {
  id                  String            @id @default(uuid())
  resourceType        AddOnResourceType @unique
  pricePerUnitMonthly Decimal           @default(0) // price for 1 unit, recurring, per month
  pricePerUnitOneOff  Decimal           @default(0) // price for 1 unit, one-time
  currency            String            @default("USD")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum CreditType {
  AI
  EMAIL
  SMS
}

// Per-plan monthly credit allowance for a credit type. Missing row or null
// monthlyAllowance = unlimited for that plan/type. No consumer wired yet -
// see docs/superpowers/specs/2026-08-25-usage-credits-design.md.
model PlanCreditAllowance {
  id               String     @id @default(uuid())
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  creditType       CreditType
  monthlyAllowance Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([planId, creditType])
}

// Append-only ledger. Positive amount = grant (plan allowance, superadmin
// top-up); negative = consumption by a feature. Balance for the current
// billing period = sum of entries since currentPeriodStart.
model CreditLedgerEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditType     CreditType
  amount         Int
  reason         String
  createdAt      DateTime     @default(now())

  @@index([organizationId, creditType, createdAt])
}

// Per-plan override of the global AddOnPricing default. Missing row for a
// (planId, resourceType) pair = use the global default - see
// docs/superpowers/specs/2026-08-25-plan-builder-design.md.
model PlanAddOnPricingOverride {
  id                  String            @id @default(uuid())
  planId              String
  plan                SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  resourceType        AddOnResourceType
  pricePerUnitMonthly Decimal
  pricePerUnitOneOff  Decimal
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([planId, resourceType])
}

model OrganizationAddOn {
  id                      String            @id @default(uuid())
  organizationId          String
  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType            AddOnResourceType
  quantity                Int
  billingMode             AddOnBillingMode
  status                  AddOnStatus       @default(ACTIVE)
  provider                String?           // "stripe" | "paystack"
  externalSubscriptionId  String?           // RECURRING only - used to cancel and to match renewal/cancellation webhooks
  currentPeriodEnd        DateTime?         // RECURRING only, informational display
  purchasedAt             DateTime          @default(now())
  cancelledAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([organizationId, resourceType, status])
  @@index([externalSubscriptionId])
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Server-side store for one-time codes and reset tokens. Only a SHA-256 hash
// of the code is stored. EMAIL_VERIFY rows are marked verifiedAt when the
// code is checked, then consumedAt when registration actually uses them -
// the server never trusts a client-sent "emailVerified" flag.
model VerificationCode {
  id         String              @id @default(uuid())
  purpose    VerificationPurpose
  identifier String              // normalized email
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([purpose, identifier])
  @@index([codeHash])
}

// Fixed-window rate limit counters. Kept in Postgres rather than process
// memory so limits hold across serverless instances.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Append-only record of queue operations (PRD 7: "all queue movements,
// reschedules, and transitions logged").
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?      // null = system / public patient action
  action         String       // e.g. entry.called, entry.transferred, appointment.rescheduled
  queueId        String?
  entryId        String?
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entryId])
}

// Outbound integration webhooks (PRD 5.3: service completion / flow
// transition updates to an EMR). Payloads are signed with HMAC-SHA256 using
// the endpoint's secret (stored encrypted).
model WebhookEndpoint {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url             String
  description     String?
  encryptedSecret String
  events          String[]          // subset of WEBHOOK_EVENTS; empty = all
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deliveries      WebhookDelivery[]
  integration     Integration?

  @@index([organizationId])
}

model WebhookDelivery {
  id           String          @id @default(uuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String          @default("PENDING") // PENDING | SUCCEEDED | FAILED
  attempts     Int             @default(0)
  responseCode Int?
  lastError    String?
  nextAttemptAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

// A connection to another system (an EMR today) through Klargy Connect
// (docs/connect/v1.md). The other system authenticates with the API key
// (only its SHA-256 hash is stored) and registers the URL Klargy sends its
// events to, which becomes the integration's own webhook endpoint.
enum IntegrationStatus {
  ACTIVE
  REVOKED
}

model Integration {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  kind               String              @default("EMR")
  status             IntegrationStatus   @default(ACTIVE)
  keyHash            String              @unique
  keyPrefix          String              // first characters of the key, so admins can tell keys apart
  scopes             String[]
  // What the other side told us about itself on registration
  systemName         String?
  systemVersion      String?
  webhookEndpointId  String?             @unique
  webhookEndpoint    WebhookEndpoint?    @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)
  lookupUrl          String?
  embedOrigins       String[]
  // The other system's records Klargy records can be mapped to:
  // {locations, services, servicePoints, practitioners, registrationFields}
  catalog            Json?
  catalogPublishedAt DateTime?
  lastUsedAt         DateTime?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  externalReferences ExternalReference[]
  idempotencyKeys    ConnectIdempotencyKey[]

  @@index([organizationId])
}

// Idempotency-Key replay for Klargy Connect writes (24 hours). statusCode 0
// means the first request with the key is still running.
model ConnectIdempotencyKey {
  id            String      @id @default(uuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  key           String
  requestHash   String
  statusCode    Int         @default(0)
  response      Json?
  createdAt     DateTime    @default(now())

  @@unique([integrationId, key])
  @@index([createdAt])
}

// Links one Klargy record to the record it mirrors in an integrated system,
// so the other system never has to store Klargy IDs. resourceType: location,
// service, service_point, staff (phase 2 adds patient, entry, journey).
model ExternalReference {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  resourceType   String
  resourceId     String       // the Klargy record
  externalId     String       // the other system's record
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([integrationId, resourceType, resourceId])
  @@unique([integrationId, resourceType, externalId])
  @@index([organizationId])
}

// Superadmin-configured LLM provider (API key encrypted at rest). At most one
// row is active; with none active, AI_PROVIDER + the provider's env key are
// used (see services/ai/index.ts).
model AiProviderConfig {
  id              String   @id @default(uuid())
  provider        String   @unique // anthropic | openai | gemini | openai_compatible
  encryptedApiKey String
  model           String?
  baseUrl         String?  // openai_compatible (and optional OpenAI/Azure proxies)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// AI answers and digests, kept with the exact aggregates the model was
// given (`sources`) so staff can check the numbers behind every statement.
model AiInsight {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String       // ASK | DIGEST
  locationId     String?
  question       String?
  answer         String
  sources        Json?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind, createdAt])
}

// Adverts, announcements and videos played on lobby screens between calls.
// locationId null = shown at every location in the organization.
model DisplayMedia {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind            String       // IMAGE | VIDEO | STREAM (YouTube, Vimeo, HLS live)
  url             String
  fileId          String?      // file storage id when uploaded through us
  title           String
  durationSeconds Int          @default(12) // images; videos play to the end (capped)
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  playlistItems   DisplayPlaylistItem[]

  @@index([organizationId, locationId, sortOrder])
}

// A named, scheduled set of media from the library ("Weekday mornings",
// "Flu season"). Days and times are the location's local time. When several
// playlists are on at once, only the highest priority plays (1 = takes over,
// 2 = normal, 3 = filler). With no playlists, the whole library plays.
model DisplayPlaylist {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?      // null = every location
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  days           String       @default("0,1,2,3,4,5,6") // 0 = Sunday
  startTime      String?      // "HH:MM" local; null = from opening
  endTime        String?      // "HH:MM" local; null = until closing
  priority       Int          @default(2)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          DisplayPlaylistItem[]

  @@index([organizationId, locationId])
}

model DisplayPlaylistItem {
  id         String          @id @default(uuid())
  playlistId String
  playlist   DisplayPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId    String
  media      DisplayMedia    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)

  @@unique([playlistId, mediaId])
}
